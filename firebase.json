{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/documents/TQC_talk_noise.pdf",
        "destination": "/documents/TQC_talk_Noise.pdf",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/(css|js|lib|images)/.*\\.[0-9a-f]{64}\\.(css|js|jpg|jpeg|png|webp|avif|svg|woff|woff2|ttf|otf)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/documents/research-statement-*.pdf",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, nosnippet"
          }
        ]
      }
    ]
  }
}
